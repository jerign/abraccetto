    <!-- Cookie Consent Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Check if consent was already given
            const cookieConsent = localStorage.getItem('cookieConsent');
            
            if (!cookieConsent) {
                // Show the banner if no consent was given yet
                document.getElementById('cookie-consent-banner').style.display = 'block';
                // Désactiver les cookies analytiques et marketing par défaut
                disableAnalytics();
                disableMarketing();
                
                // Traduire explicitement les éléments du widget des cookies
                if (typeof translateCookieElements === 'function') {
                    translateCookieElements();
                }
            } else {
                // Apply saved preferences
                const preferences = JSON.parse(cookieConsent);
                applyPreferences(preferences);
            }
            
            // Accept all cookies
            document.getElementById('accept-all-cookies').addEventListener('click', function() {
                const preferences = {
                    necessary: true,
                    analytics: true,
                    marketing: true
                };
                savePreferences(preferences);
                document.getElementById('cookie-consent-banner').style.display = 'none';
            });
            
            // Accept only necessary cookies
            document.getElementById('accept-necessary-cookies').addEventListener('click', function() {
                const preferences = {
                    necessary: true,
                    analytics: false,
                    marketing: false
                };
                savePreferences(preferences);
                document.getElementById('cookie-consent-banner').style.display = 'none';
            });
            
            // Open preferences modal
            document.getElementById('cookie-preferences').addEventListener('click', function() {
                // Hide the cookie consent banner when opening preferences
                document.getElementById('cookie-consent-banner').style.display = 'none';
                
                // Set checkboxes based on current preferences
                const savedPreferences = localStorage.getItem('cookieConsent');
                if (savedPreferences) {
                    const preferences = JSON.parse(savedPreferences);
                    document.getElementById('analytics-cookies').checked = preferences.analytics;
                    document.getElementById('marketing-cookies').checked = preferences.marketing;
                }
                
                $('#cookie-preferences-modal').modal('show');
                
                // Traduire explicitement les éléments du modal
                if (typeof translateCookieElements === 'function') {
                    translateCookieElements();
                }
            });
            
            // When modal is closed without saving, show the banner again if no consent was stored
            $('#cookie-preferences-modal').on('hidden.bs.modal', function () {
                if (!localStorage.getItem('cookieConsent')) {
                    document.getElementById('cookie-consent-banner').style.display = 'block';
                }
            });
            
            // Save preferences from modal
            document.getElementById('save-preferences').addEventListener('click', function() {
                const preferences = {
                    necessary: true, // Always required
                    analytics: document.getElementById('analytics-cookies').checked,
                    marketing: document.getElementById('marketing-cookies').checked
                };
                savePreferences(preferences);
                document.getElementById('cookie-consent-banner').style.display = 'none';
                $('#cookie-preferences-modal').modal('hide');
            });
            
            function savePreferences(preferences) {
                localStorage.setItem('cookieConsent', JSON.stringify(preferences));
                applyPreferences(preferences);
            }
            
            function applyPreferences(preferences) {
                if (preferences.analytics) {
                    enableAnalytics();
                } else {
                    disableAnalytics();
                }
                
                if (preferences.marketing) {
                    enableMarketing();
                } else {
                    disableMarketing();
                }
            }
            
            function disableAnalytics() {
                // Désactiver Google Analytics/Google Tag Manager
                window['ga-disable-GTM-KKWRCBNB'] = true;
                
                // Supprimer les cookies Google Analytics existants
                deleteCookie('_ga');
                deleteCookie('_gat');
                deleteCookie('_gid');
                
                // Bloquer les futurs appels à dataLayer
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push = function() {
                    // Ne pas exécuter les événements analytics si désactivés
                    const args = arguments[0];
                    if (!args.event || args.event === 'gtm.js' || args.event.indexOf('gtm.') === 0) {
                        return;
                    }
                    // Autoriser les autres événements qui ne sont pas liés à l'analytique
                    Array.prototype.push.apply(this, arguments);
                };
            }
            
            function enableAnalytics() {
                // Réactiver Google Analytics/GTM
                window['ga-disable-GTM-KKWRCBNB'] = false;
                
                // Restaurer le dataLayer
                window.dataLayer = window.dataLayer || [];
                // Réinitialiser la méthode push originale
                delete window.dataLayer.push;
                
                // Recharger GTM si nécessaire
                if (!window.google_tag_manager) {
                    // Si GTM n'est pas chargé, on peut le recharger ici
                    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
                    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
                    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
                    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
                    })(window,document,'script','dataLayer','GTM-KKWRCBNB');
                }
            }
            
            function disableMarketing() {
                // Désactiver Facebook Pixel
                if (window.fbq) {
                    window.fbq = function() {};
                }
                
                // Supprimer les cookies de FB existants
                deleteCookie('_fbp');
                deleteCookie('_fbc');
                
                // Bloquer les scripts de remarketing
                blockMarketingScripts();
            }
            
            function enableMarketing() {
                // Réactiver Facebook Pixel si nécessaire
                if (!window._fbq) {
                    !function(f,b,e,v,n,t,s)
                    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
                    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
                    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
                    n.queue=[];t=b.createElement(e);t.async=!0;
                    t.src=v;s=b.getElementsByTagName(e)[0];
                    s.parentNode.insertBefore(t,s)}(window, document,'script',
                    'https://connect.facebook.net/en_US/fbevents.js');
                    fbq('init', '769331374559096');
                    fbq('track', 'PageView');
                }
            }
            
            function blockMarketingScripts() {
                // Cette fonction peut être étendue pour bloquer d'autres scripts marketing
                // comme le remarketing Google ou autres pixels publicitaires
            }
            
            function deleteCookie(name) {
                document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
                document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=.' + window.location.hostname + ';';
            }
        });
    </script>
