    <!-- Fonctions globales pour la popup réservation -->
    <script>
        function openReservationPopup() {
            var overlay = document.getElementById('reservation-popup-overlay');
            var iframe = document.getElementById('reservation-popup-iframe');
            if (!overlay || !iframe) { alert('Erreur: popup non trouvée'); return; }
            var docLang = (window.currentReservationLang || (document.cookie.match(/lang=([^;]+)/) && document.cookie.match(/lang=([^;]+)/)[1]) || (document.getElementById('lang') && document.getElementById('lang').value) || document.documentElement.getAttribute('lang') || 'fr').toString().substr(0, 2);
            var otLang = { fr: 'fr-FR', en: 'en-US', es: 'es-ES' }[docLang] || 'fr-FR';
            iframe.src = 'https://www.opentable.fr/widget/reservation/canvas?rid=342114&domain=fr&type=standard&theme=tall&lang=' + otLang + '&iframe=true&overlay=false&v=' + Date.now();
            overlay.classList.add('is-open');
            overlay.setAttribute('aria-hidden', 'false');
            overlay.setAttribute('margin', 'auto');
            document.body.style.overflow = 'hidden';
        }
        function closeReservationPopup() {
            var overlay = document.getElementById('reservation-popup-overlay');
            var iframe = document.getElementById('reservation-popup-iframe');
            if (!overlay) return;
            overlay.classList.remove('is-open');
            overlay.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            if (iframe) iframe.src = 'about:blank';
        }
    </script>

    <!-- Module flottant Réservation : onclick direct pour fiabilité maximale -->
    <button type="button" id="reservation-floating-btn" data-i18n="Reservation-btn Reservation-btn-label Reservation-btn-label" data-i18n-attr="innerHTML title aria-label" title="Réserver une table" aria-label="Ouvrir la réservation" style="z-index: 99998;" onclick="openReservationPopup(); return false;">Réserver</button>

    <!-- Popup réservation OpenTable -->
    <div id="reservation-popup-overlay" class="reservation-popup-overlay" aria-hidden="true" onclick="if(event.target===this) closeReservationPopup();">
        <div class="reservation-popup-box" role="dialog" aria-modal="true" aria-labelledby="reservation-popup-title">
            <button type="button" class="reservation-popup-close" data-i18n="Reservation-popup-close" data-i18n-attr="aria-label" aria-label="Fermer" onclick="closeReservationPopup();">&times;</button>
            <header class="reservation-popup-header">
                <h3 id="reservation-popup-title" data-i18n="Reservation-popup-title">Réserver une table</h3>
                <p data-i18n="Reservation-popup-subtitle">A Braccetto — Paris</p>
            </header>
            <div class="reservation-popup-body">
                <iframe id="reservation-popup-iframe" src="about:blank" data-i18n="Reservation-iframe-title" data-i18n-attr="title" title="Réservation OpenTable"></iframe>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                var o = document.getElementById('reservation-popup-overlay');
                if (o && o.classList.contains('is-open')) closeReservationPopup();
            }
        });
    </script>

