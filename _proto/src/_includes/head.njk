<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="language" content="{{ langName }}">
<title>{{ title }}</title>
<link rel="apple-touch-icon" sizes="180x180" href="{{ assetsBase }}/favicon_io/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="{{ assetsBase }}/favicon_io/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="{{ assetsBase }}/favicon_io/favicon-16x16.png">
<link rel="shortcut icon" type="image/x-icon" href="{{ assetsBase }}/favicon_io/favicon.ico">
<link rel="manifest" href="{{ assetsBase }}/images/favicons/manifest.json">
<link rel="mask-icon" href="{{ assetsBase }}/images/favicons/safari-pinned-tab.svg" color="#5bbad5">
<meta name="theme-color" content="#ffffff">

<link href="{{ assetsBase }}/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="{{ assetsBase }}/lib/loaders.css/loaders.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css?family=Hind+Madurai:300,400,500,600,700|Playfair+Display:400,400i,700,700i,900,900i" rel="stylesheet">
<link href="{{ assetsBase }}/lib/hamburgers/dist/hamburgers.min.css" rel="stylesheet">
<link href="{{ assetsBase }}/lib/font-awesome/css/font-awesome.min.css" rel="stylesheet">
<link href="{{ assetsBase }}/lib/lightbox2/dist/css/lightbox.css" rel="stylesheet">
<link href="{{ assetsBase }}/css/style.css" rel="stylesheet">
<link href="{{ assetsBase }}/css/custom.css" rel="stylesheet">

{# SEO multilingue — hreflang réciproque cuit dans le HTML #}
<link rel="canonical" href="{{ site.url }}{{ canonicalPath }}">
<link rel="alternate" hreflang="x-default" href="{{ site.url }}/">
<link rel="alternate" hreflang="fr" href="{{ site.url }}/">
<link rel="alternate" hreflang="en" href="{{ site.url }}/en/">
<link rel="alternate" hreflang="es" href="{{ site.url }}/es/">
<meta property="og:locale" content="{{ ogLocale }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ canonicalPath }}">
<meta name="description" content="{{ description }}">
