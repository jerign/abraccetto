<!DOCTYPE html>
<html lang="{{ lang }}">

<head>
    <meta charset="utf-8">
    <script>window.dataLayer = window.dataLayer || [];</script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon_io/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon_io/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon_io/favicon-16x16.png">
    <link rel="shortcut icon" type="image/x-icon" href="/assets/favicon_io/favicon.ico">
    <link rel="manifest" href="/assets/images/favicons/manifest.json">
    <link rel="mask-icon" href="/assets/images/favicons/safari-pinned-tab.svg" color="#5bbad5">
    <meta name="msapplication-TileImage" content="/assets/images/favicons/mstile-150x150.png">
    <meta name="theme-color" content="#ffffff">

    <link href="/assets/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/lib/loaders.css/loaders.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Hind+Madurai:300,400,500,600,700|Playfair+Display:400,400i,700,700i,900,900i" rel="stylesheet">
    <link href="/assets/lib/hamburgers/dist/hamburgers.min.css" rel="stylesheet">
    <link href="/assets/lib/font-awesome/css/font-awesome.min.css" rel="stylesheet">
    <link href="/assets/css/style.css" rel="stylesheet">
    <link href="/assets/css/custom.css" rel="stylesheet">

    <meta name="description" content="{{ description }}">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
    <link rel="canonical" href="{{ site.url }}{{ canonicalPath }}">
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}/faq.html">
    <link rel="alternate" hreflang="fr" href="{{ site.url }}/faq.html">
    <link rel="alternate" hreflang="en" href="{{ site.url }}/en/faq.html">
    <link rel="alternate" hreflang="es" href="{{ site.url }}/es/faq.html">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="A Braccetto">
    <meta property="og:locale" content="{{ ogLocale }}">
    {% if lang != "fr" %}<meta property="og:locale:alternate" content="fr_FR">{% endif %}
    {% if lang != "en" %}<meta property="og:locale:alternate" content="en_US">{% endif %}
    {% if lang != "es" %}<meta property="og:locale:alternate" content="es_ES">{% endif %}
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="{{ site.url }}{{ canonicalPath }}">
    <meta property="og:image" content="{{ site.url }}/assets/images/main-header-1.jpg">
    <meta property="og:image:alt" content="A Braccetto — restaurant italien Paris 5e">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="{{ site.url }}/assets/images/main-header-1.jpg">
    <meta name="geo.region" content="FR-75">
    <meta name="geo.placename" content="Paris">
    <meta name="geo.position" content="48.8465;2.3417">
    <meta name="ICBM" content="48.8465, 2.3417">

    {%- set faqKeys = ["lieu","horaires","cuisine","reserver","brunch","privatisation","tard","romantique","groupe","pates-pizza","terrasse","vegetarien"] %}
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "{{ site.url }}{{ canonicalPath }}#faq",
  "inLanguage": "{{ lang }}",
  "mainEntityOfPage": "{{ site.url }}{{ canonicalPath }}",
  "mainEntity": [
    {%- for key in faqKeys %}
    {
      "@type": "Question",
      "name": {{ ("Faq-q-" + key) | t(lang) | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ ("Faq-a-" + key) | t(lang) | dump | safe }}
      }
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
    </script>

    <style>
      .faq-hero { min-height: 38vh; }
      .seo-faq__item { background: #fff; border-radius: 4px; margin-bottom: 0.75rem; padding: 0.25rem 0; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
      .seo-faq__q { cursor: pointer; padding: 1rem 1.25rem; font-weight: 600; list-style: none; }
      .seo-faq__q::-webkit-details-marker { display: none; }
      .seo-faq__q::before { content: "+"; display: inline-block; width: 1.5em; color: #c89b6c; font-weight: 700; }
      details[open] > .seo-faq__q::before { content: "−"; }
      .seo-faq__a { padding: 0 1.25rem 1rem 2.75rem; color: #555; line-height: 1.6; }
      .seo-faq__back { margin-top: 2rem; }
    </style>
</head>

<body data-spy="scroll" data-target=".inner-link" data-offset="60">
    <main>
        {% include "nav.njk" %}

        <section class="py-0 overflow-hidden faq-hero">
            <div class="background-holder overlay overlay-2 parallax"
                style="background-image:url(/assets/images/chozen/resize/A_BRACCETTO_1669.jpg);"></div>
            <div class="container">
                <div class="row align-items-center justify-content-center text-center pt-8 pb-6"
                    style="height: 38vh; min-height: 220px;">
                    <div class="col">
                        <h1 class="color-white fs-5 fs-lg-7" data-i18n="Faq-titre">Questions fréquentes</h1>
                        <p class="color-white mt-3" data-i18n="Faq-intro">Tout savoir sur A Braccetto avant de venir.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-7 background-white">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-9">
                        <div class="seo-faq">
                            {%- for key in faqKeys %}
                            <details class="seo-faq__item">
                                <summary class="seo-faq__q" data-i18n="Faq-q-{{ key }}">Question</summary>
                                <div class="seo-faq__a" data-i18n="Faq-a-{{ key }}">Réponse</div>
                            </details>
                            {%- endfor %}
                        </div>
                        <div class="text-center seo-faq__back">
                            <a href="{% if lang != 'fr' %}/{{ lang }}{% endif %}/" class="btn btn-outline-secondary" data-i18n="Faq-retour">← Retour à l'accueil</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="text-center pb-3">
            <div class="background-holder overlay overlay-2"
                style="background-image:url(/assets/images/chozen/resize/A_BRACCETTO_1552\ 1.jpg);background-position: top;">
            </div>
            <div class="container">
                <div class="row mt-6 fs--1">
                    <div class="col-lg">
                        <div class="color-8">
                            &copy;A Braccetto 2026 all right reserved
                            <div class="footer-links mt-2">
                                <a href="{% if lang != 'fr' %}/{{ lang }}{% endif %}/faq.html" class="mr-3 color-white" data-i18n="FooterLinks.FAQ">FAQ</a>
                                <a href="{% if lang != 'fr' %}/{{ lang }}{% endif %}/legal-notice.html" class="mr-3 color-white" data-i18n="FooterLinks.LegalNotice">Mentions légales</a>
                                <a href="{% if lang != 'fr' %}/{{ lang }}{% endif %}/terms-of-use.html" class="mr-3 color-white" data-i18n="FooterLinks.TermsOfUse">CGU</a>
                                <a href="{% if lang != 'fr' %}/{{ lang }}{% endif %}/privacy-policy.html" class="mr-3 color-white" data-i18n="FooterLinks.PrivacyPolicy">Politique de confidentialité</a>
                                <a href="{% if lang != 'fr' %}/{{ lang }}{% endif %}/cookie-policy.html" class="color-white" data-i18n="FooterLinks.CookiePolicy">Politique de cookies</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script src="/assets/lib/jquery/dist/jquery.min.js"></script>
    <script src="/assets/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/assets/js/config.js"></script>
    <script src="/assets/js/zanimation.js"></script>
    <script src="/assets/js/core.js"></script>
    <script src="/assets/js/main.js"></script>
    {% include "cookie-reservation.njk" %}
</body>

</html>
