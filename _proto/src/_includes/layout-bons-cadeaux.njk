<!DOCTYPE html>
<html lang="{{ lang }}">

<head>
    <meta charset="utf-8">
    <script>window.dataLayer = window.dataLayer || [];</script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon_io/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon_io/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon_io/favicon-16x16.png">
    <link rel="shortcut icon" type="image/x-icon" href="/assets/favicon_io/favicon.ico">
    <link rel="manifest" href="/assets/images/favicons/manifest.json">
    <link rel="mask-icon" href="/assets/images/favicons/safari-pinned-tab.svg" color="#5bbad5">
    <meta name="msapplication-TileImage" content="/assets/images/favicons/mstile-150x150.png">
    <meta name="theme-color" content="#ffffff">
    <link href="/assets/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/lib/loaders.css/loaders.min.css" rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css?family=Hind+Madurai:300,400,500,600,700|Playfair+Display:400,400i,700,700i,900,900i"
        rel="stylesheet">
    <link href="/assets/lib/hamburgers/dist/hamburgers.min.css" rel="stylesheet">
    <link href="/assets/lib/font-awesome/css/font-awesome.min.css" rel="stylesheet">
    <link href="/assets/css/style.css" rel="stylesheet">
    <link href="/assets/css/custom.css" rel="stylesheet">
    <meta name="description" content="{{ description }}">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
    <link rel="canonical" href="{{ site.url }}{{ canonicalPath }}">
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}/bons-cadeaux.html">
    <link rel="alternate" hreflang="fr" href="{{ site.url }}/bons-cadeaux.html">
    <link rel="alternate" hreflang="en" href="{{ site.url }}/en/bons-cadeaux.html">
    <link rel="alternate" hreflang="es" href="{{ site.url }}/es/bons-cadeaux.html">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="A Braccetto">
    <meta property="og:locale" content="{{ ogLocale }}">
    <meta property="og:locale:alternate" content="en_US">
    <meta property="og:locale:alternate" content="es_ES">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="{{ site.url }}{{ canonicalPath }}">
    <meta property="og:image" content="https://abraccettoparis.com/assets/images/main-header-1.jpg">
    <meta property="og:image:alt" content="A Braccetto — restaurant italien Paris 5e">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="https://abraccettoparis.com/assets/images/main-header-1.jpg">
    <meta name="geo.region" content="FR-75">
    <meta name="geo.placename" content="Paris">
    <meta name="geo.position" content="48.8465;2.3417">
    <meta name="ICBM" content="48.8465, 2.3417">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "{{ 'Accueil' | t(lang) }}", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "{{ 'Bons-cadeaux-title' | t(lang) }}", "item": "{{ site.url }}{{ canonicalPath }}" }
      ]
    }
  ]
}
    </script>
</head>

<body>
    <main>
        {% include "nav.njk" %}
        <section class="py-0 overflow-hidden">
            <div class="background-holder overlay overlay-2 parallax"
                style="background-image:url(/assets/images/chozen/resize/A_BRACCETTO_1669.jpg);"></div>
            <div class="container">
                <div class="row align-items-center justify-content-center text-center pt-8 pb-6"
                    style="height: 40vh; min-height: 260px;">
                    <div class="col">
                        <div class="overflow-hidden">
                            <h1 class="color-white fs-5 fs-lg-7" data-i18n="Bons-cadeaux-title">Bons cadeaux</h1>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="pt-5 pb-3">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-10 text-center">
                        <p class="lead" data-i18n="Bons-cadeaux-intro">Offrez un moment chez A Braccetto : un dîner, un brunch, un menu dégustation pizza. Bons cadeaux à offrir, valables dans notre restaurant du 5e arrondissement.</p>
                    </div>
                </div>
            </div>
        </section>
        <section class="pb-6">
            <div class="container">
                <iframe id="bonkdo-iframe" title="Boutique bons cadeaux A Braccetto"
                    style="width:100%; border:0; min-height:900px;"
                    src="https://abraccettoparis.bonkdo.com?embed=true&hide_main_title_description=false&hide_footer=false&hide_whychooseus=false&hide_create_money_pot=false&hide_group_payment=false&hide_shared_gifts_header=false&hide_whole_shared_gifts=false&hide_giftcards=false&hide_vouchers=false"
                    loading="lazy"></iframe>
                <noscript>
                    <p style="text-align:center; margin-top:1rem;">
                        <a href="https://abraccettoparis.shop.bonkdo.com/fr/bons-cadeaux" rel="noopener" data-i18n="Bons-cadeaux-fallback">Accéder à la boutique de bons cadeaux</a>
                    </p>
                </noscript>
            </div>
        </section>
    </main>
    <footer>
        <div class="row mt-6 fs--1">
            <div class="col-lg">
                <div class="color-8">&copy;Abraccetto 2026 all right reserved</div>
            </div>
        </div>
    </footer>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/modernizr/2.8.3/modernizr.min.js"></script>
    <script src="/assets/lib/jquery/dist/jquery.min.js"></script>
    <script src="/assets/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <script type="module" src="/assets/js/index.js"></script>
    <script src="https://abraccettoparis.bonkdo.com/static/js/iframeResizer.min.js"></script>
    <script>
        if (typeof iFrameResize === "function") {
            iFrameResize({ checkOrigin: false, heightCalculationMethod: "lowestElement" }, "#bonkdo-iframe");
        }
    </script>
    {% include "cookie-reservation.njk" %}
</body>
</html>
