        .menu-preview-image {
            max-width: 100%;
            max-height: 70vh;
            width: auto;
            height: auto;
            object-fit: contain;
            display: block;
            margin: 0 auto 1rem auto;
        }
        
        .hoverbox {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        
        .hoverbox {
            max-width: 400px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
        }
        
        .hoverbox img {
            width: 100%;
            max-width: 400px;
            height: auto;
            object-fit: contain;
            display: block;
        }
        
        .hoverbox h3 {
            margin-top: 1rem;
            padding: 0.5rem;
            text-align: center;
            white-space: normal;
            word-wrap: break-word;
            line-height: 1.5;
        }
        
        .degustation-photos {
            margin-top: 0;
        }
        
        .degustation-photos img {
            width: 100%;
            height: auto;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
        }
        
        .degustation-photos img:hover {
            transform: scale(1.02);
        }
        
        /* Alignement des photos pour former un carré */
        .photos-gallery-row {
            align-items: stretch;
        }
        
        .photos-gallery-row .col-lg-4 {
            display: flex;
            flex-direction: column;
        }
        
        .photos-gallery-row .col-lg-4 .row {
            height: 100%;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        
        .photos-gallery-row .col-lg-4 .col-lg-12 {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        
        .photos-gallery-row .col-lg-4 .col-lg-12 a,
        .photos-gallery-row .col-lg-8 a {
            display: flex;
            height: 100%;
            flex: 1;
        }
        
        .photos-gallery-row .col-lg-4 img,
        .photos-gallery-row .col-lg-8 img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        
        .photos-gallery-row .col-lg-8 {
            display: flex;
            flex-direction: column;
        }
        
        @media (max-width: 991px) {
            .photos-gallery-row .col-lg-4 .col-lg-12,
            .photos-gallery-row .col-lg-8 {
                margin-bottom: 1rem;
            }
            
            .photos-gallery-row .col-lg-4 img,
            .photos-gallery-row .col-lg-8 img {
                height: auto;
                object-fit: contain;
            }
        }
        
        .presentation-text {
            background-color: #f8f9fa;
            padding: 2rem;
            border-radius: 8px;
            margin-bottom: 2rem;
        }
        
        .presentation-text h3 {
            color: #351606;
            margin-bottom: 1rem;
        }
        
        .presentation-text p {
            color: #333;
            line-height: 1.8;
            margin-bottom: 0.5rem;
        }
        
        @media (max-width: 768px) {
            .menu-preview-image {
                max-height: 50vh;
                width: 100%;
            }
            
            .degustation-photos {
                margin-top: 1rem;
            }
        }
        
        @media (max-width: 576px) {
            .menu-preview-image {
                max-height: 40vh;
                width: 100%;
            }
            
            .presentation-text {
                padding: 1.5rem;
            }
        }
    </style>
